#[test]
fun parity_v2_type_hashes() {
    assert!(arc_eip712::type_hash_v2_root() == x"7ea4ea672e840ea4ebdc3cde4681f593b387568fe3ddf874beef01e919f0dd31", 0);
    assert!(arc_eip712::type_hash_v2_lease() == x"5b54e21f719bf2d1a9a4ed84cd113427ef6dacfd34ce7680ad1e3a395f409f7f", 0);
    assert!(arc_eip712::type_hash_v2_action() == x"b8d16dc9a409e9c02e60f83cc867dc3071f1a606fddf7ebcfe6e08a7376414ef", 0);
}

#[test]
fun parity_v2_root_lease_action_digests() {
    let chain = 31337u256;
    let root_struct = arc_eip712::hash_v2_root(1u64, &TOKEN, &RECIPIENT, &ADAPTER, &RECOVERY, 20u256, 40u256, 100u256, 100u64, 1000u64);
    let root_digest = arc_eip712::digest(b"2", chain, &ACCOUNT, root_struct);
    assert!(root_digest == x"de43725aeddee42f44a925c4200701783b10fd7822a85ca281f2c560eca92ab6", 0);
    let lease_struct = arc_eip712::hash_v2_lease(&LEASE_ID, &root_digest, &AGENT, 1000u64, 2000u64, 10u256, 30u256, 80u256);
    assert!(arc_eip712::digest(b"2", chain, &ACCOUNT, lease_struct) == x"b2938186652fd5074cbda4a739772386156a742e6b251035e6e08bdd44f87035", 1);
    let action_struct = arc_eip712::hash_v2_action(&LEASE_ID, 1u256, 9u8, &TOKEN, &RECIPIENT, &ADAPTER, 10u256, 1900u64, 0u256, &ZERO_ADDR, &PLAN);
    assert!(arc_eip712::digest(b"2", chain, &ACCOUNT, action_struct) == x"4ffd052b01267ce413cc97c4e7efa32b7955cc54662b126028b2f5c8b6c28ec6", 2);
}

#[test, expected_failure(abort_code = arc_eip712::EBadLength)]
fun parity_rejects_short_verifying_contract() {
    arc_eip712::domain_separator(b"3", 31337u256, &x"0102");
}

#[test]
fun parity_v3_domain_is_chain_and_account_bound() {
    let a = arc_eip712::domain_separator(b"3", 31337u256, &x"0000000000000000000000000000000000000001");
    assert!(a != arc_eip712::domain_separator(b"3", 5042002u256, &x"0000000000000000000000000000000000000001"), 0);
    assert!(a != arc_eip712::domain_separator(b"3", 31337u256, &x"0000000000000000000000000000000000000002"), 1);
    assert!(a != arc_eip712::domain_separator(b"2", 31337u256, &x"0000000000000000000000000000000000000001"), 2);
    assert!(a != eip712::domain_separator(), 3);
}

